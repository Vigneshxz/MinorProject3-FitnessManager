
@page
@model MinorProject3.Web.Pages.Clients.CreateModel

@{
    ViewData["Title"] = "Add Client";
}

<h1>Add New Client</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Client.FirstName" class="form-label"></label>
        <input asp-for="Client.FirstName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Client.LastName" class="form-label"></label>
        <input asp-for="Client.LastName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Client.Email" class="form-label"></label>
        <input asp-for="Client.Email" type="email" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Client.Phone" class="form-label"></label>
        <input asp-for="Client.Phone" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Client</button>

    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
