
@page
@using MinorProject3.Data
@inject ClientRepository ClientRepo

@{
    ViewData["Title"] = "Clients";

    string firstName = Request.Query["firstName"].ToString();
    string lastName = Request.Query["lastName"].ToString();

    var clients = ClientRepo.SearchClients(firstName, lastName);
}

<h1>Gym Clients</h1>

<p>Search and manage all registered gym clients.</p>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label for="firstName" class="form-label">First Name</label>
        <input type="text"
               id="firstName"
               name="firstName"
               value="@firstName"
               class="form-control"
               placeholder="Search first name" />
    </div>

    <div class="col-md-4">
        <label for="lastName" class="form-label">Last Name</label>
        <input type="text"
               id="lastName"
               name="lastName"
               value="@lastName"
               class="form-control"
               placeholder="Search last name" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">
            Search
        </button>

        <a asp-page="./Index" class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

<a asp-page="./Create" class="btn btn-success mb-3">
    + Add Client
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var client in clients)
        {
            <tr>
                <td>@client.ClientId</td>
                <td>@client.FirstName</td>
                <td>@client.LastName</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@client.ClientId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-page="./Delete"
                       asp-route-id="@client.ClientId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (clients.Count == 0)
{
    <p class="text-muted">No clients found.</p>
}
