
@page "{id:int}"
@model MinorProject3.Web.Pages.Exercises.EditModel

@{
    ViewData["Title"] = "Edit Exercise";
}

<h1>Edit Exercise</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Exercise.ExerciseId" />

    <div class="mb-3">
        <label asp-for="Exercise.ExerciseName" class="form-label">Exercise Name</label>
        <input asp-for="Exercise.ExerciseName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Exercise.MuscleGroup" class="form-label">Muscle Group</label>
        <input asp-for="Exercise.MuscleGroup" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Exercise.Equipment" class="form-label">Equipment</label>
        <input asp-for="Exercise.Equipment" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Exercise.Difficulty" class="form-label">Difficulty</label>
        <input asp-for="Exercise.Difficulty" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
